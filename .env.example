# Lead delivery modes: pulse (default), shadow, emailjs, or supabase.
# Pulse is the Headliner CRM of record. The application proxies form submissions through
# its same-origin /api/intake route, so these first two values are optional overrides.
NEXT_PUBLIC_FORM_DELIVERY_MODE=pulse
NEXT_PUBLIC_CRM_API_BASE_URL=/api/intake
NEXT_PUBLIC_CRM_TENANT_ID=00000000-0000-0000-0000-000000000001
# Optional alternate delivery path.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_SCHEMA=public
NEXT_PUBLIC_SUPABASE_LEADS_TABLE=leads
